SHINKAI_ENV=development
SHINKAI_AUTH_REQUIRED=false
SHINKAI_ADMIN_TOKEN=
SHINKAI_SUBSCRIBER_TOKENS=[]
SHINKAI_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+
SHINKAI_DEEPSEEK_API_KEY=
SHINKAI_DEEPSEEK_BASE_URL=https://api.deepseek.com
SHINKAI_LLM_MODEL=deepseek-chat
SHINKAI_WEB_SEARCH_STRATEGY=auto
SHINKAI_TAVILY_API_KEY=
# Vertex AI Grounding — supported successor to the closed-to-new-customers
# Custom Search JSON API. Required for SHINKAI_WEB_SEARCH_STRATEGY=vertex_grounding.
SHINKAI_GOOGLE_CLOUD_PROJECT=
SHINKAI_GOOGLE_CLOUD_LOCATION=us-central1
SHINKAI_GOOGLE_APPLICATION_CREDENTIALS=
SHINKAI_VERTEX_MODEL=gemini-2.5-flash
# Legacy Google Custom Search JSON API — grandfathered customers only.
SHINKAI_GOOGLE_SEARCH_API_KEY=
SHINKAI_GOOGLE_SEARCH_ENGINE_ID=
SHINKAI_PERSISTENCE_ENABLED=true
SHINKAI_DATABASE_URL=
SHINKAI_PERSISTENCE_JSON_FALLBACK=true
SHINKAI_STATE_PATH=.shinkai/state.json
